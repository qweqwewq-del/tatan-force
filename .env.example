NODE_ENV=production
PORT=4174
APP_ORIGIN=https://www.example.com
DATABASE_URL=postgres://tatan_force:replace-me@postgres:5432/tatan_force
SESSION_SECRET=replace-with-at-least-32-random-characters
OWNER_USERNAME=tatan_master
OWNER_PASSWORD=replace-with-a-strong-owner-password
ADMIN_USERNAME=tatan_admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
# Optional one-time recovery control. Set a unique 16+ character value only
# for a credential reset deployment, then remove it from Railway afterwards.
CREDENTIAL_RESET_TOKEN=
COOKIE_SECURE=true

# local | s3
STORAGE_DRIVER=s3
UPLOAD_DIR=server/uploads
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=tatan-force-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=https://cdn.example.com

# Browser uses same-origin /api in production.
VITE_API_BASE_URL=/api

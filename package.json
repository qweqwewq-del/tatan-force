{
  "name": "tatan-force-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "tsx server/src/scripts/dev-all.ts",
    "build": "tsc -b && vite build --configLoader runner",
    "build:api": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview --configLoader runner",
    "start:api": "node server/dist/index.js",
    "db:migrate": "tsx server/src/scripts/migrate.ts",
    "db:seed": "tsx server/src/scripts/seed.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
